# VCS
.git
.gitattributes
.gitignore
.github

# Secrets — never bake these into an image
.env
.env.*
!.env.example

# Dependencies (installed inside the image)
node_modules
vendor

# Build output copied in from the asset stage
public/build
public/hot
public/storage

# Local runtime state
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
database/*.sqlite
.phpunit.cache
.phpunit.result.cache

# Not needed at runtime
tests
coverage-report
chrome-extension
vscode-extension
*.vsix
*.md
docker-compose.yml
Dockerfile
Dockerfile.web
.editorconfig
.whitesource
